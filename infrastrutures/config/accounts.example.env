# AWS deployment region
export AWS_REGION=ap-southeast-1

# Account 1 - Test Core
export CORE_PROFILE=datablue-test-core
export CORE_ACCOUNT_ID=111111111111

# Account 4 - Test Entry
export ENTRY_PROFILE=datablue-test-entry
export ENTRY_ACCOUNT_ID=444444444444

# Terraform remote backend is owned by Account 1 (Core)
# S3 bucket names are globally unique; replace the placeholder with your account/project suffix.
export TF_STATE_BUCKET=datablue-tfstate-ap-southeast-1-REPLACE-ME
export TF_LOCK_TABLE=datablue-test-tflocks
